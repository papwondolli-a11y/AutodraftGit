# Default rules for deployment.
qnx: target.path = /tmp/$${TARGET}/bin
else: unix:!android: target.path = /opt/$${TARGET}/bin
!isEmpty(target.path): INSTALLS += target

# Debug 빌드에서만 소스 경로 매크로를 정의한다.
# Release(배포) 빌드에서는 APP_SOURCE_PATH가 정의되지 않으므로
# 각 모듈이 QCoreApplication::applicationDirPath()를 사용하게 된다.
CONFIG(debug, debug|release) {
    DEFINES += APP_SOURCE_PATH=\\\"$$PWD\\\"
}

RC_ICONS = autodraft.ico
RESOURCES += \
    icons.qrc \
    translations.qrc \
    help.qrc

# 영문 UI 번역. 원문(msgid)은 한글, 표시용 번역은 translations/autodraft_en.ts.
# .ts -> .qm 컴파일은 translations/build_translations.bat 로 수동 실행하고,
# 생성된 autodraft_en.qm 은 translations.qrc 를 통해 실행파일에 임베드된다.
TRANSLATIONS = translations/autodraft_en.ts

